# --- shared -------------------------------------------------------------
# postgres:// or postgresql+asyncpg:// (driver suffix is ignored). Port 6432 is
# treated as PgBouncer (simple protocol); force it with DB_SIMPLE_PROTOCOL=true.
DATABASE_URL=postgres://user:pass@host:5432/paytrack
DB_SIMPLE_PROTOCOL=false
LOG_LEVEL=info

# --- api ----------------------------------------------------------------
API_ADDR=:9710
# openssl rand -base64 32   (encrypts Daraja credentials + webhook secrets; never change without re-encrypting)
ENCRYPTION_KEY=
# openssl rand -base64 48 (signs 15-minute access tokens)
JWT_SECRET=
# Dashboard sessions: short access token + rotating httpOnly refresh cookie.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# false only for plain-http localhost
COOKIE_SECURE=false
# The dashboard proxies the API at <dashboard>/api (Next.js rewrite)
API_PUBLIC_PATH=/api
API_TRUST_XFF=true
# Canonical dashboard URL used in email links and as the default OAuth return origin
APP_BASE_URL=http://localhost:3009
# Comma-separated origins of the dashboard frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public HTTPS base of the callback role (ngrok URL in development)
PUBLIC_CALLBACK_BASE_URL=https://your-tunnel.ngrok-free.app

# --- callback -----------------------------------------------------------
CALLBACK_ADDR=:9711
# Optional comma-separated CIDRs allowed to post callbacks (Safaricom's published IPs in production)
CALLBACK_ALLOWED_CIDRS=
# Set true when behind a load balancer that appends X-Forwarded-For
CALLBACK_TRUST_XFF=false

# --- worker -------------------------------------------------------------
WORKER_ADDR=:9712
KAFKA_BROKERS=localhost:9719
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
# Allow webhook URLs on private IPs (local testing only)
WEBHOOK_ALLOW_PRIVATE=false

# --- platform Daraja app (api + worker) ----------------------------------
# Every STK push is signed with this app's shortcode/passkey; tenants' channels
# only set where the money is routed (PartyB + AccountReference).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Override the Daraja base URL (testing against a mock only)
DARAJA_BASE_URL=

# --- docker compose host ports (container ports are 9710/9711) ----------
API_HOST_PORT=9710
CALLBACK_HOST_PORT=9711

# --- Google sign-in (OAuth web client; leave both empty to disable) ------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web):
#   Authorized JavaScript origins: http://localhost:3009
#   Authorized redirect URIs:      http://localhost:3009/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email (Resend). Without RESEND_API_KEY emails are only logged -------
RESEND_API_KEY=
EMAIL_FROM="App <user@mails.example.co.ke>"
EMAIL_REPLY_TO=
