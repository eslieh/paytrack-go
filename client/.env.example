# Where the Next.js server proxies /api/* (the PayTrack API role). Server-side only.
API_PROXY_TARGET=http://localhost:9710
# Public API URL shown to developers in docs and code samples (tenant backends call it directly).
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:9710
# Public URL of this site (canonical links, sitemap, social images). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://paytrack.pesagrid.co.ke
